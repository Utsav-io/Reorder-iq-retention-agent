{
  "name": "WF-01 Data & opportunity detection",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "ad02c18a-d56a-4363-823d-b4a4121a56e0",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH stats AS (\n  SELECT c.customer_id,\n         c.market,\n         c.loyalty_tier,\n         c.consent_status,\n         COUNT(o.order_id) FILTER (WHERE o.order_timestamp >= now() - interval '60 days')  AS orders_recent_60,\n         COUNT(o.order_id) FILTER (WHERE o.order_timestamp <  now() - interval '60 days'\n                                     AND o.order_timestamp >= now() - interval '120 days') AS orders_prior_60,\n         ROUND(AVG(o.gross_order_value), 2)                                               AS avg_order_value,\n         EXTRACT(DAY FROM now() - MAX(o.order_timestamp))::int                             AS days_since_last_order\n  FROM customers c\n  LEFT JOIN orders o\n         ON o.customer_id = c.customer_id AND o.order_status = 'completed'\n  GROUP BY c.customer_id, c.market, c.loyalty_tier, c.consent_status\n)\nSELECT *,\n       CASE\n         WHEN consent_status = 'opted_out' THEN 'excluded_no_consent'\n         WHEN orders_prior_60 >= 6 AND orders_recent_60 <= orders_prior_60 * 0.5 THEN 'at_risk'\n         WHEN orders_prior_60 >= 6 THEN 'healthy'\n         ELSE 'low_history'\n       END AS segment\nFROM stats\nORDER BY customer_id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        0
      ],
      "id": "5b37d91d-248d-4023-9e87-9476818ea133",
      "name": "Calculate customer metrics",
      "credentials": {
        "postgres": {
          "id": "9LHdXp0fGat1urGY",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "fa0d435a-b8c2-4884-b027-9dba90612238",
              "leftValue": "={{ $json.segment }}",
              "rightValue": "at_risk",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
