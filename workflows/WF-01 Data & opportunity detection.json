      ],
      "id": "a888022e-9599-428e-a551-e9c5f53023dc",
      "name": "Keep at_risk only"
    },
    {
      "parameters": {
        "jsCode": "// Next-best-action policy v1 (matches blueprint: reminder first, no discount by default)\nreturn $input.all().map(item => {\n  const c = item.json;\n  const days = Number(c.days_since_last_order);\n\n  let action, reason;\n\n  if (c.consent_status !== 'opted_in') {\n    action = 'no_action';\n    reason = 'Consent missing - hard stop';\n  } else if (days <= 7) {\n    action = 'no_action';\n    reason = 'Ordered recently - suppress from win-back';\n  } else {\n    action = 'personalized_reminder';\n    reason = 'Previously frequent, order rate declining';\n  }\n\n  return {\n    json: {\n      ...c,\n      next_action: action,\n      reason: reason,\n      discount_pct: 0,\n      expected_discount_cost: 0,\n      policy_version: 'v1',\n      approval_status: 'pending_approval'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "3484fcd8-3bbf-4bb5-a431-ebaea8bfc86b",
      "name": "Decide Next Best Action"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash",
          "mode": "list",
          "cachedResultName": "Gemini 3.5 Flash"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a retention analyst for a food-delivery app. Explain the decision below in one short sentence for an internal dashboard. Do not invent facts or numbers.\n\nCustomer: {{ $json.customer_id }} ({{ $json.market }}, {{ $json.loyalty_tier }} tier)\nOrders in last 60 days: {{ $json.orders_recent_60 }}\nOrders in the 60 days before that: {{ $json.orders_prior_60 }}\nDays since last order: {{ $json.days_since_last_order }}\nDecision: {{ $json.next_action }} with {{ $json.discount_pct }}% discount\n\nReply with only JSON in this exact format:\n{\"explanation\": \"<one sentence>\"}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1120,
        0
      ],
      "id": "22e33d28-03b0-47f0-9850-a873b26d18eb",
      "name": "AI EXPLAIN DECISION",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "vqS2RnWux8bU72wy",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "maxItems": 3
      },
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        896,
        0
      ],
      "id": "c96f43d0-1d3e-4da0-b035-8223b5293009",
      "name": "Test Limit",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Pull the explanation out of Gemini's reply and re-attach the customer data\nconst base = $('Test Limit').all();\n\nreturn $input.all().map((item, i) => {\n  const parts = (item.json.content && item.json.content.parts) || [];\n  const textPart = parts.find(p => typeof p.text === 'string');\n  let raw = textPart ? textPart.text : '';\n\n  // remove json fences\n  raw = raw.replace(/json/gi, '').replace(/```/g, '').trim();\n\n  let explanation;\n  let parse_ok = true;\n  try {\n    explanation = JSON.parse(raw).explanation;\n  } catch (e) {\n    parse_ok = false;\n    explanation = 'AI output could not be parsed';\n  }\n\n  return { json: { ...base[i].json, explanation, parse_ok } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        0
      ],
      "id": "f266a4db-824a-4e0d-b57c-3598d56836e2",
      "name": "Parse AI Output",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Keep only the fields that exist as columns in action_recommendations\nreturn $input.all().map(item => {\n  const c = item.json;\n  return {\n    json: {\n      customer_id: c.customer_id,\n      segment: c.segment,\n      next_action: c.next_action,\n      reason: c.reason,\n      discount_pct: c.discount_pct,\n      expected_discount_cost: c.expected_discount_cost,\n      explanation: c.explanation,\n      policy_version: c.policy_version,\n      approval_status: c.approval_status\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
